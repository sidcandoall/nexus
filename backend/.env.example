# MongoDB Atlas - Team Mind Mirror cluster (cluster0.abmnzeo.mongodb.net)
# Get connection string from: Atlas → Connect → Drivers → Copy connection string
# Replace <password> with your password (encode @ as %40)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abmnzeo.mongodb.net/mind_mirror?retryWrites=true&w=majority&appName=Cluster0

# Database name
MONGODB_DATABASE=mind_mirror

# Enforce Atlas usage at startup (recommended for team consistency)
MONGODB_REQUIRE_ATLAS=true

# Mongo latency protection (lower values = faster fallback when DB is unreachable)
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1200
MONGODB_CONNECT_TIMEOUT_MS=1200
MONGODB_SOCKET_TIMEOUT_MS=2000

# If DB fails, skip DB attempts for this many seconds and use memory fallback
MONGODB_UNAVAILABLE_COOLDOWN_SECONDS=30

# Sentiment model source
# false = use built-in local Hugging Face model
# true = call your remotely hosted sentiment endpoint
SENTIMENT_USE_REMOTE_MODEL=false

# Prefer loading your local zipped mood model before built-in local model
SENTIMENT_USE_LOCAL_ZIP_MODEL=true

# Path to your local zipped model
SENTIMENT_LOCAL_MODEL_ZIP=models/mood_model.zip

# Where zip contents are extracted for runtime loading
SENTIMENT_LOCAL_MODEL_EXTRACT_DIR=models/.extracted

# Performance tuning
# Preload model at startup so first API request is faster
SENTIMENT_PRELOAD_ON_STARTUP=true

# Token max length for inference (32-512). Lower is faster.
SENTIMENT_MAX_LENGTH=256

# Optional text used for startup warmup
SENTIMENT_WARMUP_TEXT=Today was okay

# When local model is primary, automatically try remote model if local fails
SENTIMENT_USE_REMOTE_FALLBACK=true

# Remote sentiment endpoint configuration (used when SENTIMENT_USE_REMOTE_MODEL=true)
# Example: https://your-hosted-model.example.com/infer
SENTIMENT_REMOTE_URL=

# Optional Bearer token for remote endpoint auth
SENTIMENT_REMOTE_API_KEY=

# Request timeout in seconds
SENTIMENT_REMOTE_TIMEOUT=20

# JSON field name used to send text to remote endpoint
# Common values: inputs, text
SENTIMENT_REMOTE_TEXT_FIELD=inputs
